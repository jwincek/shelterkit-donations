{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "starter-shelter/business-slideshow",
    "version": "1.0.0",
    "title": "Business Member Slideshow",
    "category": "starter-shelter",
    "icon": "slides",
    "description": "Rotating slideshow of active business members with approved logos.",
    "keywords": [ "business", "member", "logo", "slideshow", "sponsor", "carousel" ],
    "textdomain": "starter-shelter",
    "supports": {
        "html": false,
        "align": [ "wide", "full" ],
        "spacing": {
            "margin": true,
            "padding": true
        },
        "interactivity": true
    },
    "attributes": {
        "showName": {
            "type": "boolean",
            "default": true
        },
        "autoplay": {
            "type": "boolean",
            "default": true
        },
        "intervalMs": {
            "type": "number",
            "default": 5000
        },
        "maxItems": {
            "type": "number",
            "default": 50
        }
    },
    "example": {
        "attributes": {
            "showName": true
        }
    },
    "viewScriptModule": "file:./view.js",
    "editorScript": "file:./edit.js",
    "style": "file:./style.css",
    "editorStyle": "file:./style.css",
    "render": "file:./render.php"
}
