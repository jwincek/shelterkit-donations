{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "shelter-donations/membership-form",
    "version": "2.0.0",
    "title": "Membership Form",
    "category": "shelterkit-donations",
    "icon": "groups",
    "description": "Membership signup form with tier selection. Supports both individual and business memberships.",
    "keywords": ["membership", "subscribe", "join", "tier", "sponsor"],
    "textdomain": "shelterkit-donations",
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "color": {
            "background": true,
            "text": true,
            "gradients": true,
            "link": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "shadow": true,
        "interactivity": {
            "clientNavigation": true
        }
    },
    "attributes": {
        "formId": {
            "type": "string",
            "default": ""
        },
        "membershipType": {
            "type": "string",
            "default": "individual",
            "enum": ["individual", "business"]
        },
        "showTypeToggle": {
            "type": "boolean",
            "default": true
        },
        "defaultTier": {
            "type": "string",
            "default": ""
        },
        "layout": {
            "type": "string",
            "default": "list",
            "enum": ["cards", "list"]
        },
        "columns": {
            "type": "number",
            "default": 3
        },
        "showBenefits": {
            "type": "boolean",
            "default": false
        },
        "showAnonymous": {
            "type": "boolean",
            "default": false
        },
        "campaignId": {
            "type": "number"
        },
        "title": {
            "type": "string",
            "default": "Become a Member"
        },
        "subtitle": {
            "type": "string",
            "default": "Join our community of animal advocates."
        },
        "submitButtonText": {
            "type": "string",
            "default": "Add Membership to Cart"
        },
        "style": {
            "type": "object",
            "default": {
                "border": {
                    "width": "1px",
                    "style": "solid",
                    "radius": "8px"
                },
                "spacing": {
                    "padding": {
                        "top": "2rem",
                        "right": "2rem",
                        "bottom": "2rem",
                        "left": "2rem"
                    }
                }
            }
        }
    },
    "example": {
        "attributes": {
            "membershipType": "individual",
            "layout": "cards",
            "title": "Become a Member"
        }
    },
    "viewScriptModule": "file:./view.js",
    "editorScript": "file:./edit.js",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
