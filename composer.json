{
	"name": "jwincek/shelter-donations",
	"description": "Animal shelter donations, memberships, and memorials management using WordPress 6.9+ Abilities API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/jwincek/shelter-donations",
	"authors": [
		{
			"name": "VCPA Humane Society",
			"homepage": "https://vcpahumane.org"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.0",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Starter_Shelter\\": "includes/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.1.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit -c phpunit-integration.xml.dist",
		"test:wc": "phpunit -c phpunit-wc.xml.dist"
	}
}
