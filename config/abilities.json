{
  "abilities": {
    "shelter-reports/annual-summary": {
      "label": "Generate Annual Summary",
      "description": "Generates annual giving summary for a donor",
      "category": "shelter-reports",
      "permission": "owner_or_admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "required": [
          "donor_id",
          "year"
        ],
        "properties": {
          "donor_id": {
            "type": "integer"
          },
          "year": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "donor": {
            "type": "object"
          },
          "year": {
            "type": "integer"
          },
          "donations": {
            "type": "object",
            "description": "Donation rollup: items, total, formatted, count"
          },
          "memorials": {
            "type": "object",
            "description": "Memorial-donation rollup: items, total, formatted, count"
          },
          "memberships": {
            "type": "object",
            "description": "Membership rollup: items, total, formatted, count"
          },
          "by_allocation": {
            "type": "array",
            "description": "Donations grouped by allocation"
          },
          "grand_total": {
            "type": "number"
          },
          "grand_formatted": {
            "type": "string"
          },
          "tax_deductible": {
            "type": "number"
          },
          "generated_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "shelter-reports/donor-summary": {
      "label": "Get Donor Summary",
      "description": "Quick-glance donor stats: lifetime giving, year-to-date giving, donation count",
      "category": "shelter-reports",
      "permission": "owner_or_admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "required": [
          "donor_id"
        ],
        "properties": {
          "donor_id": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "donation_count": {
            "type": "integer"
          },
          "lifetime_giving": {
            "type": "number"
          },
          "lifetime_giving_formatted": {
            "type": "string"
          },
          "ytd_giving": {
            "type": "number"
          },
          "ytd_giving_formatted": {
            "type": "string"
          }
        }
      }
    },
    "shelter-reports/dashboard-stats": {
      "label": "Get Dashboard Statistics",
      "description": "Retrieves statistics for admin dashboard",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "today",
              "week",
              "month",
              "quarter",
              "year",
              "ytd",
              "fiscal_year",
              "calendar_year",
              "all_time",
              "custom"
            ],
            "default": "month",
            "description": "Reporting period; matches Helpers\\get_date_range_for_period."
          },
          "fiscal_year": {
            "type": "integer",
            "description": "Specific fiscal year when period='fiscal_year'."
          },
          "campaign_id": {
            "type": "integer",
            "description": "Filter by sd_campaign term ID. 0/omitted = no filter. Scopes the donations/memberships/memorials rollups; donor counts stay unfiltered (donors aren't directly campaign-tagged)."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "period": { "type": "string" },
          "date_range": { "type": "object" },
          "generated_at": { "type": "string" },
          "donations": {
            "type": "object",
            "properties": {
              "total": { "type": "number" },
              "total_formatted": { "type": "string" },
              "count": { "type": "integer" },
              "unique_donors": { "type": "integer" },
              "average": { "type": "number" }
            }
          },
          "memberships": {
            "type": "object",
            "properties": {
              "active": { "type": "integer" },
              "new": { "type": "integer" },
              "expiring_soon": { "type": "integer" },
              "revenue": { "type": "number" },
              "revenue_formatted": { "type": "string" },
              "by_tier": {
                "type": "object",
                "description": "Per-tier breakdown keyed by tier slug; each value is { count, revenue }."
              }
            }
          },
          "memorials": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "new": { "type": "integer" },
              "revenue": { "type": "number" },
              "revenue_formatted": { "type": "string" }
            }
          },
          "donors": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "new": { "type": "integer" }
            }
          }
        }
      }
    },
    "shelter-reports/donation-trend": {
      "label": "Donation Trend",
      "description": "Aggregate donation totals over time, bucketed by day / iso-week / month depending on the period's span. Replaces a GROUP BY DATE_FORMAT() query in the reports view.",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "default": "fiscal_year",
            "description": "Reporting period (see Helpers\\get_date_range_for_period)."
          },
          "fiscal_year": {
            "type": "integer",
            "description": "Specific fiscal year when period='fiscal_year'."
          },
          "campaign_id": {
            "type": "integer",
            "description": "Filter by sd_campaign term ID. 0/omitted = no filter. Restricts the bucketed totals to donations attached to the campaign."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "period":     { "type": "string" },
          "bucket":     { "type": "string", "description": "day | week | month" },
          "date_range": { "type": "object" },
          "buckets": {
            "type": "array",
            "description": "Each: { key, period_start, total, count }"
          }
        }
      }
    },
    "shelter-reports/membership-retention": {
      "label": "Membership Retention",
      "description": "Computes the renewal rate for memberships whose end_date fell in a trailing window. Self-correlated SQL is encapsulated here so the renderer stays presentation-only.",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "window_months": {
            "type": "integer",
            "default": 12,
            "description": "Trailing window in months."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "window_months":  { "type": "integer" },
          "window_start":   { "type": "string" },
          "window_end":     { "type": "string" },
          "expired_count":  { "type": "integer" },
          "renewed_count":  { "type": "integer" },
          "retention_rate": { "type": "number" }
        }
      }
    },
    "shelter-reports/action-items": {
      "label": "Get Pending Action Items",
      "description": "Returns the unified list of items needing admin attention (pending logos, expiring memberships, family notifications). Consumed by the menu badge and the dashboard-widget action list.",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "expiring_window_days": {
            "type": "integer",
            "default": 7,
            "description": "Membership end_date window (days from today). Default mirrors ACTION_ITEMS_WINDOW_DAYS in includes/abilities/reports.php."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "description": "Each item: { type, count, label, label_plural, url }."
          }
        }
      }
    },
    "shelter-reports/recent-activity": {
      "label": "Get Recent Activity",
      "description": "Returns the most recent donations, memberships, and memorials as a unified feed for the dashboard widget. Replaces a 60-line raw UNION ALL query with Query::for() per CPT + merge in PHP.",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 5,
            "description": "Maximum items to return across all three CPTs."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "description": "Each item: { type, id, post_date, created_ts, amount, donor_id, donor_name, is_anonymous, tier, honoree_name }."
          }
        }
      }
    },
    "shelter-reports/campaign-progress": {
      "label": "Campaign Progress",
      "description": "Type-aware progress for an sd_campaign term. donation_drive returns raised dollars; membership_drive returns count of new memberships (optionally restricted by tier). Replaces ad-hoc 'raised' reimplementations across the codebase.",
      "category": "shelter-reports",
      "permission": "public",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "required": [ "campaign_id" ],
        "properties": {
          "campaign_id": { "type": "integer", "description": "sd_campaign term ID." },
          "date_from":   { "type": "string", "description": "Optional Y-m-d to bound the lookback." },
          "date_to":     { "type": "string", "description": "Optional Y-m-d to bound the lookback." }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "campaign_id":  { "type": "integer" },
          "name":         { "type": "string" },
          "type":         { "type": "string", "description": "donation_drive | membership_drive" },
          "goal":         { "type": "number" },
          "goal_unit":    { "type": "string", "description": "currency | members" },
          "goal_formatted": { "type": "string" },
          "end_date":     { "type": "string" },
          "tier_filter":  { "type": "string" },
          "raised":       { "type": "number", "description": "Sum of donation amounts (donation_drive); 0 otherwise." },
          "raised_formatted": { "type": "string" },
          "member_count": { "type": "integer", "description": "New memberships matched (membership_drive); 0 otherwise." },
          "progress":     { "type": "number", "description": "0..100 percent of goal." },
          "remaining":    { "type": "number" },
          "remaining_formatted": { "type": "string" },
          "is_active":    { "type": "boolean" }
        }
      }
    },
    "shelter-reports/campaigns-progress": {
      "label": "Campaigns Progress (Batch)",
      "description": "Batch sibling of shelter-reports/campaign-progress: returns the same per-campaign payload for many campaigns in 2-3 SQL queries (one GROUP BY per type + a term-meta prime) instead of N invocations. Used by the Reports → Campaigns tab.",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "campaign_ids": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Optional list of sd_campaign term IDs. Empty/omitted = all campaigns."
          },
          "include_ended": {
            "type": "boolean",
            "default": true,
            "description": "When false, campaigns past their end_date are filtered out."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "campaigns": {
            "type": "array",
            "description": "Array of campaign-progress entries (same shape as shelter-reports/campaign-progress output)."
          }
        }
      }
    },
    "shelter-reports/campaign-report": {
      "label": "Generate Campaign Report",
      "description": "Generates a detailed report for a specific campaign",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "required": [
          "campaign_id"
        ],
        "properties": {
          "campaign_id": {
            "type": "integer",
            "description": "Campaign term ID"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "campaign": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "type": { "type": "string", "description": "donation_drive | membership_drive" },
              "goal": { "type": "number" },
              "goal_formatted": { "type": "string" },
              "tier_filter": { "type": "string" }
            }
          },
          "progress": {
            "type": "object",
            "description": "Shape depends on campaign.type. donation_drive: { total_raised, total_formatted, percent_of_goal, donation_count, donor_count, average, remaining }. membership_drive: { member_count, percent_of_goal, remaining }.",
            "properties": {
              "total_raised": { "type": "number" },
              "total_formatted": { "type": "string" },
              "percent_of_goal": { "type": "number" },
              "donation_count": { "type": "integer" },
              "donor_count": { "type": "integer" },
              "average": { "type": "number" },
              "remaining": { "type": "number" },
              "member_count": { "type": "integer" }
            }
          },
          "donations": {
            "type": "array",
            "description": "Individual donations (donation_drive only — empty array for membership_drive)."
          },
          "memberships": {
            "type": "array",
            "description": "Individual memberships (membership_drive only — empty array for donation_drive)."
          }
        }
      }
    }
  }
}
