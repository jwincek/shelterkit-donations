{
  "abilities": {
    "shelter-reports/annual-summary": {
      "label": "Generate Annual Summary",
      "description": "Generates annual giving summary for a donor",
      "category": "shelter-reports",
      "permission": "owner_or_admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "required": [
          "donor_id",
          "year"
        ],
        "properties": {
          "donor_id": {
            "type": "integer"
          },
          "year": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "donor": {
            "type": "object"
          },
          "year": {
            "type": "integer"
          },
          "donations": {
            "type": "object",
            "description": "Donation rollup: items, total, formatted, count"
          },
          "memorials": {
            "type": "object",
            "description": "Memorial-donation rollup: items, total, formatted, count"
          },
          "memberships": {
            "type": "object",
            "description": "Membership rollup: items, total, formatted, count"
          },
          "by_allocation": {
            "type": "array",
            "description": "Donations grouped by allocation"
          },
          "grand_total": {
            "type": "number"
          },
          "grand_formatted": {
            "type": "string"
          },
          "tax_deductible": {
            "type": "number"
          },
          "generated_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "shelter-reports/donor-summary": {
      "label": "Get Donor Summary",
      "description": "Quick-glance donor stats: lifetime giving, year-to-date giving, donation count",
      "category": "shelter-reports",
      "permission": "owner_or_admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "required": [
          "donor_id"
        ],
        "properties": {
          "donor_id": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "donation_count": {
            "type": "integer"
          },
          "lifetime_giving": {
            "type": "number"
          },
          "lifetime_giving_formatted": {
            "type": "string"
          },
          "ytd_giving": {
            "type": "number"
          },
          "ytd_giving_formatted": {
            "type": "string"
          }
        }
      }
    },
    "shelter-reports/dashboard-stats": {
      "label": "Get Dashboard Statistics",
      "description": "Retrieves statistics for admin dashboard",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "today",
              "week",
              "month",
              "quarter",
              "year"
            ],
            "default": "month"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "donations": {
            "type": "object",
            "properties": {
              "total": {
                "type": "number"
              },
              "count": {
                "type": "integer"
              },
              "change_percent": {
                "type": "number"
              }
            }
          },
          "memberships": {
            "type": "object",
            "properties": {
              "active": {
                "type": "integer"
              },
              "new": {
                "type": "integer"
              },
              "expiring_soon": {
                "type": "integer"
              }
            }
          },
          "memorials": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "new": {
                "type": "integer"
              }
            }
          },
          "donors": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "new": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "shelter-reports/campaign-report": {
      "label": "Generate Campaign Report",
      "description": "Generates a detailed report for a specific campaign",
      "category": "shelter-reports",
      "permission": "admin",
      "meta": {
        "annotations": {
          "readonly": true,
          "destructive": false,
          "idempotent": true
        },
        "show_in_rest": true
      },
      "input_schema": {
        "type": "object",
        "required": [
          "campaign_id"
        ],
        "properties": {
          "campaign_id": {
            "type": "integer",
            "description": "Campaign term ID"
          },
          "include_donations": {
            "type": "boolean",
            "default": true,
            "description": "Include individual donation records"
          },
          "include_donors": {
            "type": "boolean",
            "default": false,
            "description": "Include donor breakdown"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "campaign": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "goal": {
                "type": "number"
              },
              "start_date": {
                "type": "string"
              },
              "end_date": {
                "type": "string"
              }
            }
          },
          "progress": {
            "type": "object",
            "properties": {
              "total_raised": {
                "type": "number"
              },
              "total_formatted": {
                "type": "string"
              },
              "percent_of_goal": {
                "type": "number"
              },
              "donation_count": {
                "type": "integer"
              },
              "donor_count": {
                "type": "integer"
              }
            }
          },
          "stats": {
            "type": "object",
            "description": "Aggregate campaign statistics"
          },
          "donations": {
            "type": "array",
            "description": "Individual donations if include_donations is true"
          },
          "donors": {
            "type": "array",
            "description": "Donor breakdown if include_donors is true"
          }
        }
      }
    }
  }
}
