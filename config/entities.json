{
    "entities": {
        "sd_donor": {
            "meta_prefix": "_sd_",
            "fields": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Donor email address"
                },
                "display_name": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Donor display name"
                },
                "first_name": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Donor first name"
                },
                "last_name": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Donor last name"
                },
                "phone": {
                    "type": "string",
                    "maxLength": 30,
                    "description": "Donor phone number"
                },
                "address": {
                    "type": "object",
                    "description": "Donor mailing address"
                },
                "user_id": {
                    "type": "integer",
                    "description": "Associated WordPress user ID"
                },
                "lifetime_giving": {
                    "type": "number",
                    "default": 0,
                    "description": "Total lifetime donations"
                },
                "first_donation_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Date of first donation"
                },
                "communication_preferences": {
                    "type": "object",
                    "description": "Email and communication preferences"
                }
            },
            "computed": {
                "full_name": {
                    "function": "concat_names",
                    "args": [
                        "first_name",
                        "last_name"
                    ]
                },
                "lifetime_giving_formatted": {
                    "function": "format_currency",
                    "args": [
                        "lifetime_giving"
                    ]
                },
                "donor_level": {
                    "function": "calculate_donor_level",
                    "args": [
                        "lifetime_giving"
                    ]
                },
                "formatted_address": {
                    "function": "format_address",
                    "args": [
                        "address"
                    ]
                }
            }
        }
    }
}